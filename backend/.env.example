# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_bureaucracy_navigator

# AI / RAG
# Any LLM provider works behind the same interface — see src/rag/README.md
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gemini-1.5-pro
VECTOR_DB_URL=replace-with-your-vector-db-connection-string

# Document processing
OCR_PROVIDER=tesseract
# If using a cloud OCR provider instead of local Tesseract:
OCR_API_KEY=

# File storage
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
